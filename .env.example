# Конфигурация корпусного тестирования конструктора запросов.
# Скопируйте этот файл в `.env` и при необходимости поправьте значения.
# Без `.env` работают значения по умолчанию (совпадают с поведением репозитория).

# Каталог эталонных запросов `ВЫБРАТЬ *` к метаданным (выгрузка внешней обработки 1С).
META_QUERIES_DIR=tmp/meta1c

# Каталог выгрузки конфигурации 1С в файлы (Конфигуратор → Выгрузить конфигурацию в файлы).
CONFIG_DIR=src/cf

# Каталог кэша метаданных конструктора (YAML), генерируется `npm run parse`.
METADATA_CACHE_DIR=tmp/parser_data

# Каталог корпуса извлечённых запросов и эталона оракула `oracle/golden.jsonl`.
QUERY_CORPUS_DIR=tmp/query1c

# Каталог отчётов об ошибках приёмки (по одному JSON-файлу на каждую ошибку).
ERRORS_DIR=tmp/corpus-errors

# URL MCP-сервера `1c-md`; если пусто — берётся из `.mcp.json`.
MCP_URL=

# Пользователь базы 1С
USER_1C=User

# Пароль базы 1С
PASSWORD_1C=Password

# Имя пользователя администратора кластера (стандарт: admin)
CLUSTER_USER=admin

# Пароль администратора кластера (НЕ должен быть пустым)
CLUSTER_PWD=adminpwd

# Имя базы 1С
DB_1C_NAME=dbname

# Сервер 1С
SERVER_1C=host.docker.internal

# Веб-публикация базы 1С (драйвер разведки реального конструктора, tooling/real-constructor).
# ТОЛЬКО host.docker.internal из контейнера (НЕ localhost). Завершающий слэш не обязателен.
WEB_1C_URL=http://host.docker.internal/smallb/ru_RU/
