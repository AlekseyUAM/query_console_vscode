{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/extension/**/*", "src/core/**/*", "src/shared/**/*", "src/cli/**/*"],
  "exclude": ["src/webview/**/*", "node_modules"]
}
