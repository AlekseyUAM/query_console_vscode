{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "jsx": "react",
    "outDir": "out/webview",
    "rootDir": "src/webview",
    "noEmit": true
  },
  "include": ["src/webview/**/*", "src/shared/**/*", "src/core/metadata/types.ts", "src/core/query/queryModel.ts"],
  "exclude": ["src/extension/**/*", "node_modules"]
}
