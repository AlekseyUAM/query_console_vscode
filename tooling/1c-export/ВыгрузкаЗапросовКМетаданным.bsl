
&НаКлиенте
Процедура Выгрузить(Команда)

	// Метаданные обходим и валидируем запросы на сервере (СхемаЗапроса
	// недоступна на тонком клиенте). На клиент возвращается соответствие
	// "имя файла" -> "текст запроса" только по валидным запросам.
	Запросы = ПолучитьТекстыЗапросов();

	СоздатьКаталог(КаталогВыгрузки);

	Сохранено = 0;
	Для Каждого КЗ Из Запросы Цикл
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(КЗ.Значение);
		ТекстовыйДокумент.Записать(КаталогВыгрузки + "/" + КЗ.Ключ, КодировкаТекста.UTF8);
		Сохранено = Сохранено + 1;
	КонецЦикла;

	ПоказатьПредупреждение(, СтрШаблон("Выгрузка завершена. Сохранено файлов: %1.", Сохранено));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекстыЗапросов()

	Результат = Новый Соответствие;

	// Объекты с одной основной таблицей.
	ОбработатьКоллекцию(Метаданные.Справочники,             "Справочник",             Результат);
	ОбработатьКоллекцию(Метаданные.Документы,               "Документ",               Результат);
	ОбработатьКоллекцию(Метаданные.Перечисления,            "Перечисление",           Результат);
	ОбработатьКоллекцию(Метаданные.ПланыВидовХарактеристик, "ПланВидовХарактеристик", Результат);
	ОбработатьКоллекцию(Метаданные.ПланыСчетов,             "ПланСчетов",             Результат);
	ОбработатьКоллекцию(Метаданные.ПланыВидовРасчета,       "ПланВидовРасчета",       Результат);
	ОбработатьКоллекцию(Метаданные.ПланыОбмена,             "ПланОбмена",             Результат);
	ОбработатьКоллекцию(Метаданные.БизнесПроцессы,          "БизнесПроцесс",          Результат);
	ОбработатьКоллекцию(Метаданные.Задачи,                  "Задача",                 Результат);

	// Регистры сведений: основная таблица + срезы.
	ОбработатьРегистры(Метаданные.РегистрыСведений, "РегистрСведений",
		"СрезПервых,СрезПоследних", Результат);

	// Регистры накопления: основная таблица + остатки/обороты.
	ОбработатьРегистры(Метаданные.РегистрыНакопления, "РегистрНакопления",
		"Остатки,Обороты,ОстаткиИОбороты", Результат);

	// Регистры бухгалтерии: основная таблица + бухгалтерские виртуальные таблицы.
	ОбработатьРегистры(Метаданные.РегистрыБухгалтерии, "РегистрБухгалтерии",
		"Остатки,Обороты,ОстаткиИОбороты,ДвиженияССубконто,ОборотыДтКт", Результат);

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ОбработатьКоллекцию(Коллекция, ИмяТипа, Результат)

	Для Каждого ОбъектМД Из Коллекция Цикл
		ТекстЗапроса = "ВЫБРАТЬ * ИЗ " + ИмяТипа + "." + ОбъектМД.Имя;
		ВалидироватьИДобавить(ТекстЗапроса, ИмяТипа, ОбъектМД.Имя, "", "", Результат);
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбработатьРегистры(Коллекция, ИмяТипа, ВиртуальныеТаблицы, Результат)

	МассивВТ = СтрРазделить(ВиртуальныеТаблицы, ",");

	// Виртуальные таблицы оборотов поддерживают периодичность: для каждой из них
	// формируем отдельный запрос на каждую периодичность из списка, подставляя её
	// третьим параметром виртуальной таблицы.
	ТаблицыСПериодичностью = "Обороты,ОстаткиИОбороты,ОборотыДтКт";
	МассивПериодичностей = СтрРазделить(
		"Запись,Период,Регистратор,НомерСтроки,Секунда,Минута,Час,День,Неделя,Месяц,Квартал,Год,Декада,Полугодие,Авто",
		",");

	Для Каждого ОбъектМД Из Коллекция Цикл

		// Основная таблица регистра.
		ТекстОсновной = "ВЫБРАТЬ * ИЗ " + ИмяТипа + "." + ОбъектМД.Имя;
		ВалидироватьИДобавить(ТекстОсновной, ИмяТипа, ОбъектМД.Имя, "", "", Результат);

		// Виртуальные таблицы.
		Для Каждого ВТ Из МассивВТ Цикл

			Если СтрНайти("," + ТаблицыСПериодичностью + ",", "," + ВТ + ",") > 0 Тогда
				// Таблица оборотов — перебираем периодичности.
				Для Каждого Периодичность Из МассивПериодичностей Цикл
					ТекстВТ = "ВЫБРАТЬ * ИЗ " + ИмяТипа + "." + ОбъектМД.Имя + "." + ВТ
						+ "(, , " + Периодичность + ")";
					ВалидироватьИДобавить(ТекстВТ, ИмяТипа, ОбъектМД.Имя, ВТ, Периодичность, Результат);
				КонецЦикла;
			Иначе
				ТекстВТ = "ВЫБРАТЬ * ИЗ " + ИмяТипа + "." + ОбъектМД.Имя + "." + ВТ + "(&Период)";
				ВалидироватьИДобавить(ТекстВТ, ИмяТипа, ОбъектМД.Имя, ВТ, "", Результат);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВалидироватьИДобавить(ТекстЗапроса, ИмяТипа, ИмяОбъекта, ИмяВТ, ИмяПериодичности, Результат)

	// Проверяем запрос схемой запроса: некорректные ссылки на таблицы
	// (например, отсутствующая виртуальная таблица) вызовут исключение.
	Попытка
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(ТекстЗапроса);
	Исключение
		Возврат;
	КонецПопытки;

	// Запрос валиден — берём нормализованный текст из схемы.
	ТекстЗапроса = Схема.ПолучитьТекстЗапроса();

	ИмяФайла = ИмяТипа + "_" + ИмяОбъекта;
	Если Не ПустаяСтрока(ИмяВТ) Тогда
		ИмяФайла = ИмяФайла + "_" + ИмяВТ;
	КонецЕсли;
	Если Не ПустаяСтрока(ИмяПериодичности) Тогда
		ИмяФайла = ИмяФайла + "_" + ИмяПериодичности;
	КонецЕсли;
	ИмяФайла = ИмяФайла + ".txt";

	Результат.Вставить(ИмяФайла, ТекстЗапроса);

КонецПроцедуры
