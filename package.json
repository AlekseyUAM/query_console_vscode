{
  "name": "query-console-1c",
  "displayName": "1C: Query Constructor",
  "description": "Visual query constructor for 1C",
  "version": "0.1.1",
  "publisher": "AlekseyYudanov",
  "author": {
    "name": "Aleksey Yudanov",
    "url": "https://t.me/aleksey_yudanov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlekseyUAM/query_console_vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "1c.queryConstructor",
        "title": "1С: Конструктор запроса"
      },
      {
        "command": "1c.parseMetadata",
        "title": "1С: Распарсить метаданные в YAML"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "1c.queryConstructor",
          "when": "resourceExtname == .bsl",
          "group": "1_modification@100"
        }
      ]
    },
    "configuration": {
      "title": "Query Console 1C",
      "properties": {
        "queryConsole.metadataPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to src/cf directory (leave empty to auto-detect)"
        },
        "queryConsole.parserOutputPath": {
          "type": "string",
          "default": "tmp/parser_data",
          "description": "Каталог для результата парсинга метаданных (YAML). Относительный путь резолвится от корня workspace."
        },
        "queryConsole.openInNewWindow": {
          "type": "boolean",
          "default": true,
          "description": "Открывать «Конструктор запроса» в отдельном окне (а не во вкладке-панели основного окна VS Code). Требует VS Code 1.85+."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "package": "vsce package --out query-console-1c.vsix",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "esbuild src/extension/extension.ts --bundle --outfile=out/extension/extension.js --platform=node --format=cjs --external:vscode --sourcemap",
    "build:cli": "esbuild src/cli/parseMetadata.ts --bundle --outfile=out/cli/parseMetadata.js --platform=node --format=cjs",
    "parse": "npm run build:cli && node out/cli/parseMetadata.js",
    "extract": "esbuild src/cli/extractQueries.ts --bundle --outfile=out/cli/extractQueries.js --platform=node --format=cjs && node out/cli/extractQueries.js",
    "ingest:meta": "esbuild src/cli/ingestMeta.ts --bundle --outfile=out/cli/ingestMeta.js --platform=node --format=cjs && node out/cli/ingestMeta.js",
    "corpus:test": "esbuild src/cli/corpusTest.ts --bundle --outfile=out/cli/corpusTest.js --platform=node --format=cjs && node out/cli/corpusTest.js",
    "corpus:snapshot": "esbuild src/cli/corpusSnapshot.ts --bundle --outfile=out/cli/corpusSnapshot.js --platform=node --format=cjs && node out/cli/corpusSnapshot.js",
    "build:oracle": "esbuild src/cli/harvestOracle.ts --bundle --outfile=out/cli/harvestOracle.js --platform=node --format=cjs && esbuild src/cli/oracleAcceptCli.ts --bundle --outfile=out/cli/oracleAcceptCli.js --platform=node --format=cjs",
    "harvest": "npm run build:oracle && node out/cli/harvestOracle.js",
    "accept:oracle": "npm run build:oracle && node out/cli/oracleAcceptCli.js",
    "oracle:diff": "esbuild src/cli/oracleDiff.ts --bundle --outfile=out/cli/oracleDiff.js --platform=node --format=cjs && node out/cli/oracleDiff.js",
    "build:webview": "esbuild src/webview/main.tsx --bundle --outfile=out/webview/main.js --platform=browser --format=iife --loader:.tsx=tsx --loader:.ts=ts",
    "watch:extension": "tsc -p tsconfig.json --watch",
    "watch:webview": "npm run build:webview -- --watch",
    "test:unit": "vitest run",
    "pretest:e2e": "npm run build:webview && cp out/webview/main.js test/e2e/harness/main.js",
    "test:e2e": "playwright test",
    "real:setup": "npx playwright install chromium && npx playwright install-deps chromium",
    "real:smoke": "esbuild tooling/real-constructor/smoke.ts --bundle --outfile=out/real-constructor/smoke.js --platform=node --format=cjs --packages=external && node out/real-constructor/smoke.js",
    "real:inventory": "esbuild tooling/real-constructor/inventory.ts --bundle --outfile=out/real-constructor/inventory.js --platform=node --format=cjs --packages=external && node out/real-constructor/inventory.js",
    "our:inventory": "npm run build:webview && esbuild tooling/our-constructor/inventory.ts --bundle --outfile=out/our-constructor/inventory.js --platform=node --format=cjs --packages=external && node out/our-constructor/inventory.js",
    "corpus:verify": "npm run build:webview && esbuild tooling/corpus-verify/verify.ts --bundle --outfile=out/corpus-verify/verify.js --platform=node --format=cjs --packages=external && node out/corpus-verify/verify.js",
    "test": "npm run test:unit",
    "dev": "npm run build && code --extensionDevelopmentPath=/workspaces/query_console_vscode"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vscode/vsce": "^3.2.0",
    "@xmldom/xmldom": "^0.9.5",
    "esbuild": "^0.21.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "serve": "^14.2.6",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "web-tree-sitter": "^0.22.6",
    "yaml": "^2.4.5"
  }
}
